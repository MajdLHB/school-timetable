# ============================================================
#  PRIVACY FIREWALL - REAL PEOPLE'S DATA NEVER LEAVES THIS PC
#  Do not weaken these rules. See docs/PRIVACY.md.
# ============================================================

# All real school data
data/
out/

# Source documents from the school
*.pdf
*.roz
*.xlsx
*.xls
*.csv
*.docx
*.xml
*.jpg
*.jpeg
*.png

# Anything explicitly marked private
*private*
*confidential*
*real*

# ---- allowed back in: templates and demo data only ----
# NOTE: *.xml is blocked by default because an aSc export dropped anywhere in
# the project carries every real teacher name. On 2026-08-24 exactly that
# happened - "last year/last-yeah.xml" (101 teachers) was caught by the
# pre-push gate. Only the hand-written test probes are allowed through.
!demo/
!demo/**
!tools/
!test/*.xml
!docs/**
# Official ministry circulars are PUBLIC documents with no personal data in
# them - they are the specification this tool is built against, so they belong
# in the repository. Every file here must be READ before it is committed.
!rules/
!rules/*.pdf
!rules/*.json

# python noise
__pycache__/
*.pyc
