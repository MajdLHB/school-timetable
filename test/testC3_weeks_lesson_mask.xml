<?xml version="1.0" encoding="UTF-8"?>
<!-- TEST C3 v2: the phantom-copies fix, learned from LAST YEAR'S REAL FILE:
     aSc 2013 counts a lesson's cards across BOTH weeks, so a week-A-only
     lesson must declare periodsperweek = cards/2 (their file contains
     periodsperweek="0.5" exactly 63 times). v1 (weeks mask on lessons)
     did NOT remove the phantoms - this version changes periodsperweek to
     0.5 / 1.0 / 1.0. Import into a 2-WEEK, 6-day project.
     PASS = same placed cards as C2, and the bottom strip is EMPTY. -->
<timetable importtype="database" options="idprefix:ABTEST3V2">
   <weeksdefs options="" columns="id,weeks,name,short">
      <weeksdef id="WALL" weeks="11" name="All weeks" short="All"/>
      <weeksdef id="WA" weeks="10" name="Week A" short="A"/>
      <weeksdef id="WB" weeks="01" name="Week B" short="B"/>
   </weeksdefs>
   <teachers options="" columns="id,name,short">
      <teacher id="T1" name="Prof Alpha" short="ALP"/>
      <teacher id="T2" name="Prof Beta" short="BET"/>
   </teachers>
   <classes options="" columns="id,name,short">
      <class id="C1" name="AB Test 3" short="AB3"/>
   </classes>
   <groups options="" columns="id,classid,name,entireclass,divisiontag,studentcount">
      <group id="G0" classid="C1" name="Entire class" entireclass="1" divisiontag="0" studentcount="30"/>
      <group id="G1" classid="C1" name="Groupe 1" entireclass="0" divisiontag="1" studentcount="15"/>
      <group id="G2" classid="C1" name="Groupe 2" entireclass="0" divisiontag="1" studentcount="15"/>
   </groups>
   <subjects options="" columns="id,name,short">
      <subject id="SVT" name="Sciences Naturelles" short="SN"/>
   </subjects>
   <classrooms options="" columns="id,name,short">
      <classroom id="R1" name="Labo 1" short="L1"/>
      <classroom id="R2" name="Labo 2" short="L2"/>
   </classrooms>
   <lessons options="" columns="id,subjectid,classids,groupids,teacherids,weeksdefid,weeks,periodspercard,periodsperweek">
      <lesson id="LW" subjectid="SVT" classids="C1" groupids="G0" teacherids="T1" weeksdefid="WA" weeks="10" periodspercard="1" periodsperweek="0.5"/>
      <lesson id="LA" subjectid="SVT" classids="C1" groupids="G1" teacherids="T1" weeksdefid="WB" weeks="01" periodspercard="2" periodsperweek="1.0"/>
      <lesson id="LB" subjectid="SVT" classids="C1" groupids="G2" teacherids="T2" weeksdefid="WB" weeks="01" periodspercard="2" periodsperweek="1.0"/>
   </lessons>
   <cards options="" columns="lessonid,period,days,weeks,classroomids">
      <card lessonid="LW" period="1" days="100000" weeks="10" classroomids="R1"/>
      <card lessonid="LA" period="3" days="100000" weeks="01" classroomids="R1"/>
      <card lessonid="LB" period="3" days="100000" weeks="01" classroomids="R2"/>
   </cards>
</timetable>
