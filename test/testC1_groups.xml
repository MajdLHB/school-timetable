<?xml version="1.0" encoding="UTF-8"?>
<!-- TEST C1: can we create a SPLIT CLASS and place the two groups in parallel?
     One class, two groups, two teachers, two rooms, same period.
     PASS = both groups appear side by side in the same slot, and aSc does NOT
     report a class clash (it must understand they are halves of one class). -->
<timetable importtype="database" options="idprefix:GRPTEST">
   <teachers options="" columns="id,name,short">
      <teacher id="T1" name="Prof Alpha" short="ALP"/>
      <teacher id="T2" name="Prof Beta" short="BET"/>
   </teachers>
   <classes options="" columns="id,name,short">
      <class id="C1" name="Group Test" short="GT"/>
   </classes>
   <groups options="" columns="id,classid,name,entireclass,divisiontag,studentcount">
      <group id="G0" classid="C1" name="Entire class" entireclass="1" divisiontag="0" studentcount="30"/>
      <group id="G1" classid="C1" name="Groupe 1" entireclass="0" divisiontag="1" studentcount="15"/>
      <group id="G2" classid="C1" name="Groupe 2" entireclass="0" divisiontag="1" studentcount="15"/>
   </groups>
   <subjects options="" columns="id,name,short">
      <subject id="SVT" name="Sciences Naturelles" short="SN"/>
   </subjects>
   <classrooms options="" columns="id,name,short">
      <classroom id="R1" name="Labo 1" short="L1"/>
      <classroom id="R2" name="Labo 2" short="L2"/>
   </classrooms>
   <lessons options="" columns="id,subjectid,classids,groupids,teacherids,periodspercard,periodsperweek">
      <lesson id="LW" subjectid="SVT" classids="C1" groupids="G0" teacherids="T1" periodspercard="1" periodsperweek="1"/>
      <lesson id="LA" subjectid="SVT" classids="C1" groupids="G1" teacherids="T1" periodspercard="2" periodsperweek="2"/>
      <lesson id="LB" subjectid="SVT" classids="C1" groupids="G2" teacherids="T2" periodspercard="2" periodsperweek="2"/>
   </lessons>
   <cards options="" columns="lessonid,period,days,classroomids">
      <card lessonid="LW" period="1" days="100000" classroomids="R1"/>
      <card lessonid="LA" period="3" days="100000" classroomids="R1"/>
      <card lessonid="LB" period="3" days="100000" classroomids="R2"/>
   </cards>
</timetable>
